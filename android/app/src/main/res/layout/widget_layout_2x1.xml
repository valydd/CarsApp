<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_2x1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamically Tinted Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_rounded_bg"
        android:scaleType="fitXY" />

    <!-- Content Layout -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Left: Unpaid Amount Info -->
        <LinearLayout
            android:id="@+id/widget_click_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RĂMAS WEEKEND"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_unpaid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 RON"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 curse neachitate"
                android:textSize="9sp"
                android:textColor="#64748B"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Right: Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Add Fuel Button -->
            <ImageView
                android:id="@+id/btn_widget_fuel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_button_bg_fuel"
                android:src="@drawable/ic_widget_fuel"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Adaugă Alimentare" />

            <!-- Add Weekend Trip Button -->
            <ImageView
                android:id="@+id/btn_widget_trip"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_button_bg_trip"
                android:src="@drawable/ic_widget_trip"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:contentDescription="Adaugă Cursă Weekend" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
