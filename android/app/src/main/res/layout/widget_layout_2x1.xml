<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_2x1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamically Tinted Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_rounded_bg"
        android:scaleType="fitXY" />

    <!-- Content: Vertical Layout for Full Width Amount & Large Buttons -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Top Section: Amount & Details (Full Width, No Truncation) -->
        <LinearLayout
            android:id="@+id/widget_click_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURSE WEEKEND"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#A78BFA"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 cursă de plată"
                    android:textSize="9.5sp"
                    android:textColor="#94A3B8"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Prominent Amount on Right -->
            <TextView
                android:id="@+id/widget_unpaid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00 RON"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:gravity="end" />
        </LinearLayout>

        <!-- Bottom Section: Two Large Action Buttons (50% Width Each) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal">

            <!-- Big Fuel Button -->
            <LinearLayout
                android:id="@+id/btn_widget_fuel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_button_bg_fuel"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_fuel"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/btn_fuel_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Alimentare"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Big Weekend Trip Button -->
            <LinearLayout
                android:id="@+id/btn_widget_trip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_button_bg_trip"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_widget_trip"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/btn_trip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Cursă"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
